# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG KẾT NỐI GITHUB & THÔNG BÁO - CRAWLER 766
# Hướng dẫn: Đổi tên hoặc sao chép tệp này thành .env và điền thông tin của bạn
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. THÔNG TIN XÁC THỰC GITHUB QUA PERSONAL ACCESS TOKEN (HTTPS)
# ------------------------------------------------------------------------------
# Phương thức xác thực Git: 'token' (HTTPS - Khuyên dùng) hoặc 'ssh' (SSH Key)
GIT_AUTH_METHOD=token

# Token truy cập cá nhân của GitHub (Personal Access Token - PAT)
# Hỗ trợ cả 2 định dạng:
#   - Classic Token: Bắt đầu bằng ghp_ (ví dụ: ghp_xxxxxxxxxxxxxxxxxxxx)
#   - Fine-grained Token (khuyên dùng): Bắt đầu bằng github_pat_ (chỉ cấp quyền cho 1 repo này)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Đường dẫn Repository trên GitHub (định dạng: owner/repo)
GITHUB_REPOSITORY=duynghiaqn/Crawler-766

# Tên tài khoản GitHub của bạn
GITHUB_USERNAME=duynghiaqn

# Nhánh git mặc định để push dữ liệu (Mặc định: main)
GIT_BRANCH=main

# Tên remote git (Mặc định: origin)
GIT_REMOTE_NAME=origin

# Thông tin tác giả ghi vào nhật ký git commit tự động
GIT_USER_NAME=Crawler 766 Bot
GIT_USER_EMAIL=crawler-bot@users.noreply.github.com

# ==============================================================================
# HƯỚNG DẪN TẠO GITHUB PERSONAL ACCESS TOKEN (PAT):
# ------------------------------------------------------------------------------
# Cách 1: Fine-grained Token (Bảo mật tối đa - Giới hạn 1 Repo):
#   1. Truy cập: https://github.com/settings/tokens?type=beta
#   2. Bấm "Generate new token"
#   3. Đặt Token name: Crawler-766-Sync
#   4. Tại "Repository access": Chọn "Only select repositories" -> Chọn "Crawler-766"
#   5. Tại "Permissions" -> "Repository permissions":
#      - "Contents": Chọn "Read and write"
#      - "Metadata": "Read-only" (tự động bật)
#   6. Bấm "Generate token" và sao chép mã (bắt đầu bằng github_pat_...) dán vào GITHUB_TOKEN ở trên.
#
# Cách 2: Classic Token (Đơn giản):
#   1. Truy cập: https://github.com/settings/tokens
#   2. Bấm "Generate new token" -> "Generate new token (classic)"
#   3. Tích chọn quyền: "repo" (Full control of private repositories)
#   4. Bấm "Generate token" và sao chép mã (bắt đầu bằng ghp_...) dán vào GITHUB_TOKEN ở trên.
#
# Chuyển Git Remote URL về giao thức HTTPS (nếu trước đó đang dùng SSH):
#   git remote set-url origin https://github.com/duynghiaqn/Crawler-766.git
# ==============================================================================

# ------------------------------------------------------------------------------
# (TÙY CHỌN PHỤ) NẾU MUỐN DÙNG SSH KEY THAY VÌ TOKEN:
# ------------------------------------------------------------------------------
# Đổi GIT_AUTH_METHOD=ssh và bỏ comment dòng dưới nếu dùng key riêng:
# GIT_SSH_KEY_PATH=

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH THÔNG BÁO TELEGRAM / GOOGLE APPS SCRIPT WEBHOOK (TÙY CHỌN)
# ------------------------------------------------------------------------------
# URL Webhook Google Apps Script trung gian gửi tin nhắn Telegram (đồng bộ với GitHub Action)
# Để trống nếu không dùng:
GAS_WEBHOOK_URL=
GAS_SECRET_KEY=

# Hoặc cấu hình trực tiếp qua Telegram Bot API (nếu không dùng qua GAS)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH MẶC ĐỊNH CHO CRAWLER
# ------------------------------------------------------------------------------
CRAWLER_TIME_TYPE=year
CRAWLER_CLEAN_DAYS=3
