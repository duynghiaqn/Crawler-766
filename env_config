# ------------------------------------------------------------------------------
# 1. THÔNG TIN XÁC THỰC GITHUB (BẮT BUỘC ĐỂ PUSH TỰ ĐỘNG KHÔNG CẦN NHẬP PASS)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (Classic - định dạng: ghp_...)
#
# Cách tạo Token Classic (ghp_...) trên GitHub:
#   1. Vào GitHub -> Settings (bấm Avatar góc trên bên phải -> Settings)
#   2. Kéo xuống cuối thanh menu bên trái, chọn: "Developer Settings"
#   3. Chọn "Personal access tokens" -> "Tokens (classic)"
#   4. Bấm nút "Generate new token" -> Chọn "Generate new token (classic)"
#   5. Đặt tên (Note, VD: Crawler-766-Bot) & Thời hạn (Expiration, VD: 90 days hoặc No expiration)
#   6. Tại mục "Select scopes": Tích chọn ô:
#      ☑️ 'repo' (Full control of private repositories)
#   7. Kéo xuống cuối trang bấm "Generate token" -> Sao chép chuỗi token (bắt đầu bằng ghp_...)
#
# (Tùy chọn khác) Nếu dùng Fine-grained Token (giới hạn 1 repo):
#   Settings -> Developer Settings -> Personal access tokens -> Fine-grained tokens
#   Repository access: "Only select repositories" -> Chọn duy nhất repo này -> Contents: "Read and write"
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Tên tài khoản GitHub của bạn
GITHUB_USERNAME=duynghiaqn

# Đường dẫn Repository trên GitHub (định dạng: owner/repo)
GITHUB_REPOSITORY=duynghiaqn/Crawler-766

# Nhánh git mặc định để push dữ liệu (Mặc định: main)
GIT_BRANCH=main

# Tên remote git (Mặc định: origin)
GIT_REMOTE_NAME=origin

# Thông tin tác giả ghi vào nhật ký git commit tự động
GIT_USER_NAME=Crawler 766 Bot
GIT_USER_EMAIL=crawler-bot@users.noreply.github.com

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH THÔNG BÁO TELEGRAM / GOOGLE APPS SCRIPT WEBHOOK (TÙY CHỌN)
# ------------------------------------------------------------------------------
# URL Webhook Google Apps Script trung gian gửi tin nhắn Telegram (đồng bộ với GitHub Action)
GAS_WEBHOOK_URL=https://script.google.com/macros/s/your_gas_deployment_id/exec
GAS_SECRET_KEY=your_gas_secret_key_here

# Hoặc cấu hình trực tiếp qua Telegram Bot API (nếu không dùng qua GAS)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH MẶC ĐỊNH CHO CRAWLER
# ------------------------------------------------------------------------------
CRAWLER_TIME_TYPE=year
CRAWLER_CLEAN_DAYS=3
