# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG KẾT NỐI GITHUB & THÔNG BÁO - CRAWLER 766
# Hướng dẫn: Đổi tên hoặc sao chép tệp này thành .env và điền thông tin của bạn
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. THÔNG TIN XÁC THỰC GITHUB QUA SSH KEY (KHUYÊN DÙNG - BẢO MẬT & VĨNH VIỄN)
# ------------------------------------------------------------------------------
# Phương thức xác thực Git: 'ssh' (Mặc định khuyên dùng) hoặc 'token'
GIT_AUTH_METHOD=ssh

# Đường dẫn Repository trên GitHub (định dạng: owner/repo)
GITHUB_REPOSITORY=duynghiaqn/Crawler-766

# Tên tài khoản GitHub của bạn
GITHUB_USERNAME=duynghiaqn

# Nhánh git mặc định để push dữ liệu (Mặc định: main)
GIT_BRANCH=main

# Tên remote git (Mặc định: origin)
GIT_REMOTE_NAME=origin

# Đường dẫn tới tệp SSH Private Key (TÙY CHỌN - để trống nếu dùng key mặc định ~/.ssh/id_ed25519 hoặc id_rsa)
# Ví dụ trên Windows: C:\Users\YourName\.ssh\id_ed25519
# Ví dụ trên Linux/Mac: ~/.ssh/id_ed25519
GIT_SSH_KEY_PATH=

# ==============================================================================
# HƯỚNG DẪN THIẾT LẬP SSH KEY VỚI GITHUB (Chỉ cần làm 1 lần):
# ------------------------------------------------------------------------------
# Bước 1: Mở Terminal / CMD / PowerShell kiểm tra hoặc tạo SSH key mới:
#   ssh-keygen -t ed25519 -C "your_email@example.com"
#   (Bấm Enter 3 lần để lưu vào đường dẫn mặc định và không đặt passphrase)
#
# Bước 2: Sao chép nội dung Public Key:
#   - Trên Windows PowerShell: Get-Content ~\.ssh\id_ed25519.pub | Set-Clipboard
#   - Trên Windows CMD:        type %USERPROFILE%\.ssh\id_ed25519.pub
#   - Trên macOS / Linux:      cat ~/.ssh/id_ed25519.pub
#
# Bước 3: Thêm key vào tài khoản GitHub:
#   Vào GitHub -> Settings -> SSH and GPG keys -> New SSH key -> Dán key vào và bấm Add SSH key
#   Hoặc truy cập trực tiếp: https://github.com/settings/ssh/new
#
# Bước 4: Chuyển remote URL của kho lưu trữ này sang giao thức SSH:
#   git remote set-url origin git@github.com:duynghiaqn/Crawler-766.git
#
# Bước 5: Kiểm tra kết nối SSH tới GitHub:
#   ssh -T git@github.com
#   (Nếu hiện: "Hi duynghiaqn! You've successfully authenticated..." là xong 100%)
# ==============================================================================

# (Tùy chọn phụ) Nếu muốn chuyển về dùng Personal Access Token (HTTPS):
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Thông tin tác giả ghi vào nhật ký git commit tự động
GIT_USER_NAME=Crawler 766 Bot
GIT_USER_EMAIL=crawler-bot@users.noreply.github.com

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH THÔNG BÁO TELEGRAM / GOOGLE APPS SCRIPT WEBHOOK (TÙY CHỌN)
# ------------------------------------------------------------------------------
# URL Webhook Google Apps Script trung gian gửi tin nhắn Telegram (đồng bộ với GitHub Action)
# Để trống nếu không dùng:
GAS_WEBHOOK_URL=
GAS_SECRET_KEY=

# Hoặc cấu hình trực tiếp qua Telegram Bot API (nếu không dùng qua GAS)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH MẶC ĐỊNH CHO CRAWLER
# ------------------------------------------------------------------------------
CRAWLER_TIME_TYPE=year
CRAWLER_CLEAN_DAYS=3
